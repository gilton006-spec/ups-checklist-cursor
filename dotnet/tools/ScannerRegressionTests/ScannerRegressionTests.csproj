<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the exact production scanner/PDF/endpoint/Razor sources offline.
         This is a console test runner, not a web host; it never provisions email. -->
    <Compile Include="../../UpsChecklist.Core/Pdf/*.cs" Link="Pdf/%(Filename)%(Extension)" />
    <Compile Include="../../UpsChecklist.Core/Scanners/*.cs" Link="Scanners/%(Filename)%(Extension)" />
    <Compile Include="../../UpsChecklist.Core/Models/ChecklistModels.cs" Link="Models/ChecklistModels.cs" />
    <Compile Include="../../UpsChecklist.Core/ChecklistPositions.cs" Link="ChecklistPositions.cs" />
    <Compile Include="../../UpsChecklist.Web/ScannerEndpoints.cs" Link="ScannerEndpoints.cs" />
    <Compile Include="../../UpsChecklist.Web/Pages/**/*.cs" Link="Pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../UpsChecklist.Web/Pages/**/*.cshtml" Link="Pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../UpsChecklist.Core/Data/scanner-lists.json" LogicalName="scanner-lists.json" />
    <None Include="../../UpsChecklist.Core/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UpsChecklist.Core/Data/workbook-source.json" Link="Data/workbook-source.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
